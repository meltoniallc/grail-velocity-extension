{
  "manifest_version": 3,
  "name": "Grail Velocity",
  "version": "2.0.3",
  "description": "Meltonia operator desk on eBay. Fast-Cash is sold tape only. Auto-capture records pages you open.",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://*.ebay.com/*",
    "https://tape-production-2810.up.railway.app/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Grail Velocity",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": false
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ebay.com/*"
      ],
      "js": [
        "lib/core.js",
        "lib/overlay.js",
        "lib/suggest.js",
        "lib/cardfields.js",
        "lib/observe.js",
        "content/parsers/common.js",
        "content/parsers/cards.js",
        "content/parsers/ebay-item.js",
        "content/parsers/ebay-sold-search.js",
        "content/parsers/ebay-active-search.js",
        "content/capture.js",
        "content/ebay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/overlay.css",
        "catalog.json"
      ],
      "matches": [
        "https://*.ebay.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
